---
// Shared SVG shapes: қошқар мүйіз (ram's horn) from Kazakh ою-өрнек, crossed with a classical bead-and-rule cornice.
// Included once per page in Base.astro; components draw them with <use href="#…">.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <path id="o-horn" d="M0 0 C0 -9 5 -16 13 -16 C21 -16 25 -9 22 -4 C19 1 13 0 13 -5 C13 -8 16 -9 18 -7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <g id="o-pair">
      <use href="#o-horn" />
      <use href="#o-horn" transform="scale(-1,1)" />
      <path d="M0 0 V8" stroke="currentColor" stroke-width="1.6" />
    </g>
    <g id="o-rosette">
      <use href="#o-pair" transform="translate(0,-8)" />
      <use href="#o-pair" transform="rotate(90) translate(0,-8)" />
      <use href="#o-pair" transform="rotate(180) translate(0,-8)" />
      <use href="#o-pair" transform="rotate(270) translate(0,-8)" />
      <circle r="2.4" fill="currentColor" />
    </g>
  </defs>
</svg>
