---
// Four ram's horns round a centre (төрт құлақ): keystones, medallions, card corners.
interface Props { size?: number; class?: string }
const { size = 48, class: cls } = Astro.props;
---
<svg class:list={['rosette', cls]} viewBox="-30 -30 60 60" width={size} height={size} aria-hidden="true"><use href="#o-rosette" transform="scale(.95)" /></svg>
