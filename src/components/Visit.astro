---
import Divider from './Divider.astro';
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { t, TICKETON, type Lang } from '../i18n/ui';
import { img } from '../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const GIS = 'https://2gis.kz/pavlodar/search/%D0%A4%D0%B8%D0%BB%D0%B0%D1%80%D0%BC%D0%BE%D0%BD%D0%B8%D1%8F%20%D0%B8%D0%BC%D0%B5%D0%BD%D0%B8%20%D0%98%D1%81%D1%8B%20%D0%91%D0%B0%D0%B9%D0%B7%D0%B0%D0%BA%D0%BE%D0%B2%D0%B0';
---
<section class="sec visit" id="kelushilerge" aria-labelledby="visit-h">
  <div class="wrap">
    <div class="sec-head"><div><span class="numeral">VI</span><h2 id="visit-h">{t(lang, 'visitTitle')}</h2><Divider /></div></div>
    <div class="visit-grid">
      <div class="card buy">
        <h3>{t(lang, 'howToBuy')}</h3>
        <p>{t(lang, 'howToBuyText')}</p>
        <a class="btn btn-seat" href={TICKETON} target="_blank" rel="noopener"><span>{t(lang, 'buyOnTicketon')}</span><Arrow /></a>
        <p class="kassa tnum" style="align-self:end">{t(lang, 'kassaFull')}</p>
      </div>
      <div class="card">
        <h3>{t(lang, 'address')}</h3>
        <div class="map-arch"><Image src={img('facade.webp')} alt="" width={720} /></div>
        <p class="v">{t(lang, 'addressValue')}</p>
        <a class="link" href={GIS} target="_blank" rel="noopener"><span>{t(lang, 'open2gis')}</span><Arrow /></a>
      </div>
      <div class="card">
        <h3>{t(lang, 'contacts')}</h3>
        <ul>
          <li><span class="k">{t(lang, 'reception')}</span><a class="v tnum" href="tel:+77182228087">+7&nbsp;(7182)&nbsp;22-80-87</a></li>
          <li><span class="k">{t(lang, 'kassa')}</span><span class="v tnum"><a href="tel:+77182680294">68-02-94</a> · <a href="tel:+77055367851">+7&nbsp;705&nbsp;536&nbsp;78&nbsp;51</a></span></li>
          <li><span class="k">E-mail</span><a class="v" href="mailto:isa.baizakov2012@yandex.kz">isa.baizakov2012@yandex.kz</a></li>
          <li><span class="k">Instagram</span><a class="v" href="https://www.instagram.com/isa_philharmonic/" target="_blank" rel="noopener">@isa_philharmonic</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
