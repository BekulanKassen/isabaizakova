---
import Divider from './Divider.astro';
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';
import { ensembles } from '../lib/data';
import { img } from '../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cls = { wide: 'w7', narrow: 'w5', half: 'half' } as const;
---
<section class="sec cols-sec" id="ujymdar" aria-labelledby="cols-h">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="numeral">II</span><h2 id="cols-h">{t(lang, 'ensemblesTitle')}</h2><Divider /></div>
      <p>{t(lang, 'ensemblesLead')}</p>
    </div>
    <div class="cols">
      {ensembles.map((e) => (
        <article class={`col ${cls[e.size]}`}>
          <div class="col-media"><div class="col-zoom"><Image src={img(e.image)} alt={e.alt[lang]} widths={[480, 960]} sizes="(min-width: 900px) 50vw, 100vw" /></div></div>
          <h3>{e.name[lang]}</h3>
          <p>{e.lead[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>
