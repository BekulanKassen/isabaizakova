---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Afisha from '../../components/Afisha.astro';
import ActionBar from '../../components/ActionBar.astro';
import Ensembles from '../../components/Ensembles.astro';
import Hall from '../../components/Hall.astro';
import History85 from '../../components/History85.astro';
import News from '../../components/News.astro';
import Visit from '../../components/Visit.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, t, type Lang } from '../../i18n/ui';
import { buildToday, events } from '../../lib/data';
import { nextConcert, upcoming } from '../../lib/afisha';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const path = `/${lang}/`;
const soon = upcoming(events, buildToday);
const HOME_LIMIT = 7;
---
<Base lang={lang} title={t(lang, 'brandFull')} description={t(lang, 'metaDescription')} path={path}>
  <Header lang={lang} path={path} home />
  <main id="main">
    <Hero lang={lang} next={nextConcert(events, buildToday)} />
    <Afisha lang={lang} events={soon.slice(0, HOME_LIMIT)} more={soon.length > HOME_LIMIT} />
    <Ensembles lang={lang} />
    <Hall lang={lang} />
    <History85 lang={lang} />
    <News lang={lang} />
    <Visit lang={lang} />
  </main>
  <Footer lang={lang} home />
  <ActionBar lang={lang} home />
</Base>
<script>
  import { initUi } from '../../scripts/ui';
  import { initAfisha } from '../../scripts/afisha-filter';
  import { initMotion } from '../../scripts/motion';
  initUi();
  initAfisha();
  initMotion();
</script>
